# Configurações do Servidor
# Valores possíveis: development, production
ENV=development
LOG_LEVEL=info

# Configurações do Backend (FastAPI)
# Define qual provedor de dados de paciente usar. Valores: POSTGRES, CSV
PACIENTE_PROVIDER_TYPE=POSTGRES

# Banco de Dados de Aplicação (SQLite local: refresh tokens, exames, frascos, etc.)
# IMPORTANTE: o código (src/main.py e alembic/env.py) lê a variável SQLITE_DSN.
SQLITE_DSN=sqlite+aiosqlite:///app.db

# Produção: PostgreSQL do Supabase para as tabelas desta aplicação.
# Exemplo: postgresql+asyncpg://postgres.PROJECT:senha@aws-0-region.pooler.supabase.com:5432/postgres
# APP_DATABASE_DSN=

# Banco de Dados AGHU (PostgreSQL)
POSTGRES_DSN=postgresql+asyncpg://user:password@host:5432/db

# Banco de Dados AGHU (Oracle)
ORACLE_DSN=oracle+oracledb://user:password@host:1521/service

# Autenticação via Active Directory
#AD_URL=ldap://ad.domain.local
#AD_BASEDN="DC=ebserhnet,DC=gov,DC=br"
# Opcional: um usuário de serviço para pesquisar grupos. Se não for fornecido, a busca será feita com as credenciais do próprio usuário.
AD_BIND_USER=
AD_BIND_PASSWORD=

# Segurança: use false em produção depois de mapear os grupos AD.
MODO_PERMISSIVO=true

# Segurança com JWT
JWT_SECRET=SUA_CHAVE_SECRETA_SUPER_FORTE_AQUI
JWT_EXP_HOURS=24
REFRESH_TOKEN_EXP_DAYS=30
